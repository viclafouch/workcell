{
  "name": "@workcell/evals",
  "private": true,
  "description": "The eval set: the real tasks a worker got wrong as Harbor cases, the worker harness and the judge for vitest-evals, and the pass^k report.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viclafouch/workcell.git",

    "eslint-plugin-turbo": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tinyrainbow": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-evals": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-harness": "catalog:",
    "@tanstack/ai-sandbox": "catalog:",
    "@workcell/core": "workspace:*",
    "tinyrainbow": "catalog:",

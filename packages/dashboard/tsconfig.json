{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "e2e", "scripts", "*.ts"],
  "compilerOptions": {
    "lib": [
      "es2025",
      "esnext.collection",
      "esnext.error",
      "esnext.temporal",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  }
}

{
  "name": "@workcell/dashboard",
  "private": true,
  "description": "The read-only dashboard of the host: the running workers, the finished tasks, the bot threads, one live panel per thread, and the feedback of the agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viclafouch/workcell.git",
    "directory": "packages/dashboard"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/server/serve-dashboard.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": true,
  "globalDependencies": [".nvmrc", "tsconfig.base.json"],
  "globalPassThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"],
  "cacheMaxAge": "7d",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true,
    "filterUsingTasks": true,
    "strictTaskEntrypointSelection": true,
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "!e2e/**"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "!skills/**"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "!skills/**"]
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!*.md"]
    },
    "test:changed": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "//#lint:root": {
      "inputs": ["*.ts", "scripts/**", "package.json"]
    },
    "//#lint:fix:root": {
      "cache": false
    },
    "//#typecheck:root": {
      "inputs": [
        "*.ts",
        "scripts/**",
        "tsconfig*.json",
        "package.json",
        "packages/*/*.ts"
      ]
    }
  }
}
